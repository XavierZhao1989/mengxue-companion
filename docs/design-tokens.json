{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "bg": {
      "canvas": { "$value": "#FAF7F2", "$type": "color", "$description": "护眼宣纸暖白背景" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "主内容卡片底色" },
      "surfaceWarm": { "$value": "#F4EFE6", "$type": "color", "$description": "次级区块暖米底色" }
    },
    "text": {
      "primary": { "$value": "#2C2621", "$type": "color", "$description": "深墨主文字 (对比度 > 12:1)" },
      "secondary": { "$value": "#6B6056", "$type": "color", "$description": "暖灰次级说明 (对比度 > 5.2:1)" },
      "muted": { "$value": "#9A8F84", "$type": "color", "$description": "辅助标签/占位符" }
    },
    "brand": {
      "primary": { "$value": "#C85A32", "$type": "color", "$description": "朱砂暖橙主按钮与强调色" },
      "primaryPressed": { "$value": "#A84724", "$type": "color", "$description": "主按钮按压态" },
      "jade": { "$value": "#2F7D63", "$type": "color", "$description": "松烟青绿打卡/成功态" },
      "amber": { "$value": "#C97A00", "$type": "color", "$description": "弱网/待处理提示" },
      "danger": { "$value": "#CF3F38", "$type": "color", "$description": "错误与警告态" }
    }
  },
  "typography": {
    "display": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": "700" },
    "h1": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": "700" },
    "h2": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": "600" },
    "body": { "fontSize": "15px", "lineHeight": "24px", "fontWeight": "400" },
    "caption": { "fontSize": "12px", "lineHeight": "18px", "fontWeight": "400" },
    "primer": { "fontSize": "28px", "lineHeight": "46px", "fontFamily": "Kaiti SC, STKaiti, serif" }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px"
  },
  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "20px",
    "pill": "9999px"
  }
}
